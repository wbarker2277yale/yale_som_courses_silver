# Copy to .env (here, or one level up in the class folder) and fill in.
# Never commit the real key.

PORTKEY_API_KEY=your-portkey-key-here

# Optional overrides — the defaults are used when these are absent.
# MODEL_NAME=gpt-6-astra
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# On Render these are set in each service's Environment settings, not in a file:
#   backend  (Web Service):  PORTKEY_API_KEY
#   frontend (Static Site):  VITE_API_URL=https://your-backend.onrender.com
